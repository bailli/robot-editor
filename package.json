{
  "name": "robot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "snapshots": "vitest run --update",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "test": "vitest run",
    "test:game": "ROBOT_GAME_TESTS=1 vitest run packages/tools/test/driver.test.ts",
    "test:without-game": "vitest run packages/formats/test/cp437.test.ts packages/formats/test/omf.test.ts packages/tools/test/tools.test.ts packages/editor/test/script-view.test.ts packages/editor/test/patch.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "robot": "node packages/tools/src/robot.ts",
    "proxy": "i686-w64-mingw32-gcc -O2 -Wall -Wextra -shared -static-libgcc -s -o tools/wine/proxy/ddraw.dll tools/wine/proxy/proxy.c tools/wine/proxy/proxy.def -lws2_32 -lgdi32",
    "editor": "pnpm --filter @robot/editor dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
